                "min_frontage_m": 8.0,
                "max_ground_coverage": "Up to 45-50% (Independent / Group Housing Options)",
                "min_room_specs": "Spacious 3 BHK configurations with separate balconies and utilities.",
                "structural_notes": "Multistory complex integration or private independent duplex frameworks."
            },
            "5": {
                "group": "HIG (High Income Group)",
                "income_bracket": "Above ₹18 Lakhs per annum",
                "min_carpet_area_sqm": 150,
