    def sqm_to_sqft(self, sqm_val):
        return sqm_val * 10.7639

    def display_menu(self):
        print("\n" + "="*70)
        print(" 🏢 HUDCO & NATIONAL URBAN HOUSING COMPLIANCE GUIDELINES ENGINE 🏢")
        print("="*70)
        for key, info in self.guidelines.items():
            print(f" [{key}] {info['group']}")
        print(" [6] Exit Dashboard")
        print("="*70)

    def analyze_compliance(self, choice):
        data = self.guidelines[choice]
        print("\n" + "•"*60)
        print(f" TECHNICAL SPECIFICATIONS REPORT: {data['group'].upper()} ")
        print("•"*60)
        print(f" 💰 Household Income Cap : {data['income_bracket']}")
        print(f" 📐 Permissible Carpet Area:")
        print(f"    - Minimum Limit    : {data['min_carpet_area_sqm']} sq.m (~{self.sqm_to_sqft(data['min_carpet_area_sqm']):.1f} sq.ft)")
        print(f"    - Maximum Limit    : {data['max_carpet_area_sqm']} sq.m (~{self.sqm_to_sqft(data['max_carpet_area_sqm']):.1f} sq.ft)")
        print(f" 🛣️ Min Plot Frontage    : {data['min_frontage_m']} meters (~{data['min_frontage_m'] * 3.28084:.1f} feet)")
        print(f" 🏗️ Max Ground Coverage  : {data['max_ground_coverage']}")
        print(f" 🚪 Minimum Room Mandate : {data['min_room_specs']}")
        print(f" 🧱 Structural System    : {data['structural_notes']}")
        print("•"*60)

    def check_plot_eligibility(self):
        print("\n--- 📏 PLOT & INCOME ELIGIBILITY CHECKER ---")
        try:
            annual_income = float(input("Enter client's Annual Household Income (in ₹ Lakhs, e.g., 4.5): ") * 100000)
            plot_area_sqft = float(input("Enter target planned built-up Carpet Area (in Sq. Feet): "))
            plot_area_sqm = plot_area_sqft / 10.7639
            
            # Identify Income Category Group
            matched_group = None
            if annual_income <= 300000:
                matched_group = "1"
            elif annual_income <= 600000:
                matched_group = "2"
            elif annual_income <= 1200000:
                matched_group = "3"
            elif annual_income <= 1800000:
                matched_group = "4"
            else:
                matched_group = "5"
                
            group_info = self.guidelines[matched_group]
            print(f"\n📊 Income Mapping: Client categorizes under {group_info['group']}")
            print(f"📐 Area Translation: {plot_area_sqft:.1f} sq.ft translates to {plot_area_sqm:.2f} sq.m")
            
            # Evaluate Compliance
            min_lim = group_info['min_carpet_area_sqm']
            max_lim = group_info['max_carpet_area_sqm']
            
            if plot_area_sqm < min_lim:
                print(f"⚠️ COMPLIANCE ALERT: The proposed built-up size is BELOW HUDCO's suggested minimal structural density ({min_lim} sq.m) for this group.")
            elif plot_area_sqm > max_lim:
                print(f"❌ COMPLIANCE VIOLATION: Proposed built-up size exceeds the strict ceiling limit ({max_lim} sq.m) permitted for institutional/subsidised affordable configurations.")
            else:
                print("✅ DESIGN PASS: The proposed carpet area falls securely within HUDCO's building limits.")
                
        except ValueError:
            print("❌ Input Error: Please enter numerical parameters.")

    def run(self):
        while True:
            self.display_menu()
            choice = input("Select an income classification index or action (1-6): ").strip()
            
            if choice in self.guidelines:
                self.analyze_compliance(choice)
                
                check_sub = input("\nWould you like to run a custom Plot Eligibility Check against this classification? (y/n): ").strip().lower()
                if check_sub == 'y':
                    self.check_plot_eligibility()
                    
            elif choice == "6":
                print("\nExiting HUDCO Compliance Framework Engine. Keep building safely!")
                break
            else:
                print("❌ Invalid selection! Please enter a choice between 1 and 6.")
                
            input("\nPress Enter to return to the core dashboard loop...")

if __name__ == "__main__":
    engine = HUDCOGuidelinesDashboard()
    engine.run()
